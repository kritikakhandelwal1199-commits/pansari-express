{
  "name": "@pansari/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DataClient interface + in-memory demo backend shared by the web and mobile apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./firebase": "./src/firebase.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pansari/shared": "*",
    "@pansari/adapters": "*"
  },
  "peerDependencies": {
    "firebase": ">=12"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  }
}
