# demo  = runs fully in the browser with sample data (no Firebase needed)
# firebase = real backend (Firestore, Auth, Functions, edge worker)
NEXT_PUBLIC_DATA_MODE=demo

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-pansari
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FUNCTIONS_REGION=asia-south1
# Use local emulators (auth 9099, firestore 8080, functions 5001)
NEXT_PUBLIC_USE_EMULATORS=true
# Cloudflare edge worker base URL
NEXT_PUBLIC_EDGE_URL=http://127.0.0.1:8787
# Turnstile site key (leave empty while TURNSTILE_MODE=mock on the worker)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
