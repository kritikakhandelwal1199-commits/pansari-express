# Copy to .env (deploy.cmd writes it for you). Leave EXPO_PUBLIC_DATA_MODE=demo for a demo build.
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FUNCTIONS_REGION=asia-south1
EXPO_PUBLIC_EDGE_URL=
# The live website; the app opens <WEB_URL>/recaptcha/ for the OTP human check.
EXPO_PUBLIC_WEB_URL=
